<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>FIR_MEANS_FIR.Client</AssemblyName>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(SPT_MANAGED)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(SPT_MANAGED)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SPT_MANAGED)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="spt-reflection" HintPath="$(SPT_PLUGINS)\spt\spt-reflection.dll" Private="false" />
  </ItemGroup>
</Project>
